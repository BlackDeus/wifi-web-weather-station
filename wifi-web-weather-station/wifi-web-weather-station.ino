// Ausgabe auf dem Display
void displayOutput(){
  display.clearDisplay();
  
  if (showBitmap){
    // Bild anzeigen
    display.drawBitmap(0, 0, myBitmap, 128, 64, WHITE);
    display.display();
  } 
  else {
    // Text anzeigen
    display.setCursor(0,0);
    display.clearDisplay();
    display.setTextSize(1.5);
    display.setTextColor(WHITE);
    
    display.print("SSID: ");
    display.print(ssid);
    display.println();
    
    display.print("Passwort: ");
    display.print(password);
    display.println();

    // IP je nach Modus anzeigen
    if (useAP) {
      display.print("IP: ");
      display.print(WiFi.softAPIP());
    }
    else 
    {
      display.print(WiFi.localIP());
    }
    
    display.display();
  }
}

// LED Steuerung
void handle_LED() {
  String path = server.uri(); 

  for (int i = 0; i < 3; i++) {
    String ledOn  = "/LED_" + String(leds[i].name) + "=ON";
    String ledOff = "/LED_" + String(leds[i].name) + "=OFF";

    if (path == ledOn) {
      digitalWrite(leds[i].pin, HIGH); // LED an
    } else if (path == ledOff) {
      digitalWrite(leds[i].pin, LOW); // LED aus
    }
  }
}

// Wetterseite erzeugen
void handleWetter() {
  String page = HTML_WETTER;

  // Platzhalter ersetzen
  page.replace("%TEMP%", String(temperature, 1));
  page.replace("%HUM%", String(humidity, 0));
  page.replace("%BRT%", String(brightness, 0));

  server.send(200, "text/html", page);
}

// LED Seite senden
void handleLED() {
  server.send(200, "text/html", HTML_LED);
}

void setup() {
  
  // DHT Sensor einschalten
  pinMode(DHT_POWER, OUTPUT);
  digitalWrite(DHT_POWER, HIGH);

  dht.begin();
  
  // LEDs vorbereiten
  for (int i = 0; i < 3; i++) {
    pinMode(leds[i].pin, OUTPUT);
    digitalWrite(leds[i].pin, LOW);
  }
  
  // Display starten
  display.begin(SSD1306_SWITCHCAPVCC, 0x3c);
  display.clearDisplay();

  displayOutput();
  
  // WLAN Modus wählen
  if (useAP) {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(ssid, password);
  }
  else {
    WiFi.mode(WIFI_STA);
    WiFi.begin(ssid, password);
  }

  // Routen definieren
  server.on("/", []() {
    server.send_P(200, "text/html", HTML_HUB);
  });

  server.on("/page1", handleWetter);
  server.on("/page2", handleLED);
  
  // LED Links
  server.on("/LED_ROT=ON", handle_LED);
  server.on("/LED_ROT=OFF", handle_LED);
  server.on("/LED_GELB=ON", handle_LED);
  server.on("/LED_GELB=OFF", handle_LED);
  server.on("/LED_GRUN=ON", handle_LED);
  server.on("/LED_GRUN=OFF", handle_LED);

  // Server starten
  server.begin();
}

void loop() {
  // Webserver bedienen
  server.handleClient();
  
  // Sensorwerte lesen
  temperature = dht.readTemperature();
  humidity  = dht.readHumidity();

  // Display alle 20 Sekunden wechseln
  if (millis() - lastSwitch > 20000) {
    showBitmap = !showBitmap;
    lastSwitch = millis();

    displayOutput();
  }
}
